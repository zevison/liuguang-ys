{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "映界",
  "version": "1.0.0",
  "identifier": "com.liuguang.ys",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ci",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "映界 — 在线影视",
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 450,
      "resizable": true,
      "decorations": true,
      "transparent": false,
      "center": true,
      "fullscreen": false,
      "maximized": false,
      "theme": null
    }],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon128.png",
      "icons/icon512.png"
    ],
    "category": "Video",
    "shortDescription": "映界 — 在线影视播放器",
    "longDescription": "映界影视 App，支持多线路源、HLS 播放、全屏观影体验。"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
